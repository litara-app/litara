# Copy this file to ".env" in the folder you start the server from (or point LITARA_ENV_FILE at another file).
# ".env" is ignored by Git. Settings already present in the real environment win over this file.
# Quote a value only if it contains spaces or "#". Restart the server after changing it.

# --- Metadata providers -------------------------------------------------------------------------------------------
# Hardcover (ADR-0087): an API token from your Hardcover account settings. Without it Hardcover shows as "not set up".
LITARA_HARDCOVER_TOKEN=

# Google Books: an API key avoids the shared anonymous rate limit that often makes keyless searches fail.
LITARA_GOOGLE_BOOKS_API_KEY=

# Open Library: a monitored contact email lets Open Library identify this server and raises the request rate. Optional.
LITARA_OPEN_LIBRARY_CONTACT=

# How long successful provider searches from the Edit metadata tab are remembered, in minutes (0 turns it off). Default 10.
# LITARA_PROVIDER_SEARCH_CACHE_MINUTES=10
