# Copy to deploy/.env for local use. Never commit real credentials.
LITARA_DB_PASSWORD=change-me-locally
LITARA_MEDIA_DIR=./media-fixtures
LITARA_HTTP_PORT=8080
# Optional tuning (defaults in apps/server/internal/config):
# LITARA_INSPECT_WORKERS=2
# LITARA_INSPECT_TIMEOUT=60s
# LITARA_INSPECT_MAX_ATTEMPTS=4
# LITARA_RESCUE_STUCK_AFTER=5m
# LITARA_LOG_LEVEL=info

# T003 API. The server refuses to start without a secret key (it protects the 60-second refresh-recovery response).
# Generate one: docker compose -f deploy/compose.yaml run --rm --no-deps --entrypoint ctl migrate gen-key
# LITARA_SECRET_KEY=
# Development/emulator only: allows the non-Secure browser cookie over plain HTTP. Never for production.
# LITARA_DEV_INSECURE_HTTP=1
# Reverse-proxy mount prefix, for example /litara (returned content/artwork paths include it):
# LITARA_PUBLIC_PATH_PREFIX=
# Password hashing work factors (argon2id):
# LITARA_ARGON2_MEMORY_KIB=65536
# LITARA_ARGON2_TIME=3
# LITARA_ARGON2_THREADS=2
