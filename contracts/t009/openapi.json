  "components": {
    "schemas": {
      "T009EditionDetails": {
        "additionalProperties": false,
        "properties": {
          "addedAt": {
            "format": "date-time",
            "type": "string"
          },
          "description": {
            "maxLength": 8000,
            "type": [
              "string",
              "null"
            ]
          },
          "editionId": {
            "format": "uuid",
            "type": "string"
          },
          "isbn": {
            "pattern": "^([0-9]{9}[0-9X]|[0-9]{13})$",
            "type": [
              "string",
              "null"
            ]
          },
          "pageCount": {
            "format": "int64",
            "maximum": 100000,
            "minimum": 1,
            "type": [
              "integer",
              "null"
            ]
          },
          "published": {
            "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$",
            "type": [
              "string",
              "null"
            ]
          },
          "publisher": {
            "maxLength": 512,
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "editionId",
          "addedAt",
          "publisher",
          "published",
          "pageCount",
          "isbn",
          "description"
        ],
        "type": "object"
      },
      "T009Personal": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/T009PersonalData"
          },
          "derivedFinishedAt": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "derivedStartedAt": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "revision": {
            "pattern": "^(0|[1-9][0-9]*)$",
            "type": "string"
          },
          "titleId": {
            "format": "uuid",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "titleId",
          "revision",
          "data",
          "derivedStartedAt",
          "derivedFinishedAt",
          "updatedAt"
        ],
        "type": "object"
      },
      "T009PersonalData": {
        "additionalProperties": false,
        "properties": {
          "finishedAt": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "ratingHalves": {
            "description": "Half stars, 1 (half a star) to 10 (five stars); null is unrated.",
            "format": "int64",
            "maximum": 10,
            "minimum": 1,
            "type": [
              "integer",
              "null"
            ]
          },
          "review": {
            "description": "Private to the author; empty is no review.",
            "maxLength": 20000,
            "type": "string"
          },
          "startedAt": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "ratingHalves",
          "review",
          "startedAt",
          "finishedAt"
        ],
        "type": "object"
      },
      "T009PersonalWrite": {
        "additionalProperties": false,
        "properties": {
          "baseRevision": {
            "pattern": "^(0|[1-9][0-9]*)$",
            "type": "string"
          },
          "capturedAt": {
            "format": "date-time",
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/T009PersonalData"
          },
          "operationId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "operationId",
          "baseRevision",
          "capturedAt",
          "data"
        ],
        "type": "object"
      },
      "T009RecordingDetails": {
        "additionalProperties": false,
        "properties": {
          "addedAt": {
            "format": "date-time",
            "type": "string"
          },
          "description": {
            "maxLength": 8000,
            "type": [
              "string",
              "null"
            ]
          },
          "isbn": {
            "pattern": "^([0-9]{9}[0-9X]|[0-9]{13})$",
            "type": [
              "string",
              "null"
            ]
          },
          "published": {
            "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$",
            "type": [
              "string",
              "null"
            ]
          },
          "publisher": {
            "maxLength": 512,
            "type": [
              "string",
              "null"
            ]
          },
          "recordingId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "recordingId",
          "addedAt",
          "publisher",
          "published",
          "isbn",
          "description"
        ],
        "type": "object"
      }
    }
  }
