{
  "openapi": "3.1.0",
  "info": {
    "title": "Litara API (T004 additions)",
    "version": "0.1.0-development",
    "description": "Library management additions under /api/v1. Shares components with contracts/t003/openapi.json."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
