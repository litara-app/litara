          }
        },
        "summary": "Read library configuration and root health",
        "tags": [
          "libraries"
        ]
      }
    },
    "/admin/libraries/{libraryId}/config": {
      "put": {
        "operationId": "putLibraryConfig",
        "parameters": [
          {
            "in": "path",
            "name": "libraryId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LibraryConfig"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LibraryDetail"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
