        "security": [
          {
            "bearer": []
          },
          {
            "browserSession": [],
            "csrf": []
          }
        ],
        "summary": "Replace library configuration",
        "tags": [
          "libraries"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "CreateLibrary": {
        "additionalProperties": false,
        "properties": {
          "config": {
            "$ref": "#/components/schemas/LibraryConfig"
          },
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "name",
          "config"
        ],
        "type": "object"
      },
      "LibraryConfig": {
        "additionalProperties": false,
        "properties": {
          "backupRoot": {
            "maxLength": 4096,
            "type": "string"
          },
          "followSymlinks": {
            "type": "boolean"
          },
          "importTemplate": {
            "maxLength": 512,
            "type": "string"
          },
          "mode": {
            "enum": [
              "index",
              "managed"
            ],
            "type": "string"
          },
          "providerOrder": {
            "items": {
              "type": "string"
            },
            "maxItems": 8,
            "type": [
              "array",
              "null"
            ],
            "uniqueItems": true
          },
          "rootPath": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "scanIntervalSecs": {
            "default": 900,
            "format": "int64",
            "minimum": 60,
            "type": "integer"
          },
          "sentinelPath": {
            "description": "Operator-supplied root identity file, relative to the root; never created automatically.",
            "maxLength": 1024,
            "type": "string"
          },
          "sentinelSha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "stabilitySecs": {
            "default": 30,
            "format": "int64",
            "minimum": 1,
            "type": "integer"
          },
          "verifyIntervalSecs": {
            "default": 86400,
            "format": "int64",
            "minimum": 3600,
            "type": "integer"
          },
          "writebackBackups": {
            "type": "boolean"
          }
        },
        "required": [
          "mode",
          "rootPath",
          "followSymlinks",
          "writebackBackups",
          "providerOrder"
        ],
        "type": "object"
      },
      "LibraryDetail": {
        "additionalProperties": false,
        "properties": {
          "config": {
            "$ref": "#/components/schemas/LibraryConfig"
          },
          "health": {
            "$ref": "#/components/schemas/RootHealth"
          },
          "library": {
            "$ref": "#/components/schemas/Library"
          }
        },
        "required": [
          "library",
          "config",
          "health"
        ],
        "type": "object"
      },
      "RootHealth": {
        "additionalProperties": false,
        "properties": {
          "checkedAt": {
            "format": "date-time",
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "state": {
            "enum": [
              "healthy",
              "unavailable",
              "identity_mismatch",
              "unknown"
            ],
            "type": "string"
          }
        },
        "required": [
          "state"
        ],
        "type": "object"
      }
    }
  }
}
