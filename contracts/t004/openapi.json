          }
        },
        "security": [
          {
            "bearer": []
          },
          {
            "browserSession": [],
            "csrf": []
          }
        ],
        "summary": "Create a library with its ingestion configuration",
        "tags": [
          "libraries"
        ]
      }
    },
    "/admin/libraries/{libraryId}": {
